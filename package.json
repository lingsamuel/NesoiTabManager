{
  "name": "nesoi-tab-manager",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "node scripts/build.mjs && node scripts/package-builds.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "bench:tree": "node scripts/bench_tree.mjs",
    "test:tree": "node scripts/test_tree.mjs && node scripts/test_tree_ui.mjs && node scripts/test_sidebar_pinned.mjs && node scripts/test_context_menu.mjs && node scripts/test_scroll_markers.mjs && node scripts/test_virtual_range.mjs",
    "preview": "vite preview --config vite.config.js"
  },
  "dependencies": {
    "vue": "^3.4.31"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "esbuild": "^0.21.5",
    "vite": "^5.4.0"
  }
}
